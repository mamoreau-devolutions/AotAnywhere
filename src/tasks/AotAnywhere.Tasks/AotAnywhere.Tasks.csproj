<Project Sdk="Microsoft.NET.Sdk">

  <!-- Managed implementation of the Windows link step. It writes the SDK's
       native MSVC arguments to a response file for lld-link and adds the
       restored MSVC/Windows SDK library paths. netstandard2.0 lets the task
       assembly load in any MSBuild. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- MSBuild provides these at run time (the task DLL is loaded into MSBuild);
       compile against them but never ship our own copy. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.8.3" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.8.3" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
