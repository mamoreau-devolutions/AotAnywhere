<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Single source of truth for the restored Clang/LLVM content package
       versions (packed alongside this file). -->
  <Import Project="$(MSBuildThisFileDirectory)ClangToolchainVersion.props" />

  <PropertyGroup>
    <DisableUnsupportedError>true</DisableUnsupportedError>
    <HostRuntimeIdentifier Condition="'$(HostRuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</HostRuntimeIdentifier>
    <UseExternalClang Condition="'$(UseExternalClang)' == ''">false</UseExternalClang>

    <AotAnywhereLinuxSysrootId />
    <AotAnywhereLinuxSysrootId Condition="'$(RuntimeIdentifier)' == 'linux-x64'">ubuntu-18.04-amd64</AotAnywhereLinuxSysrootId>
    <AotAnywhereLinuxSysrootId Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">ubuntu-18.04-arm64</AotAnywhereLinuxSysrootId>
    <AotAnywhereLinuxSysrootId Condition="'$(RuntimeIdentifier)' == 'linux-arm'">ubuntu-22.04-arm</AotAnywhereLinuxSysrootId>
    <AotAnywhereLinuxSysrootId Condition="'$(RuntimeIdentifier)' == 'linux-musl-x64'">alpine-3.17-amd64</AotAnywhereLinuxSysrootId>
    <AotAnywhereLinuxSysrootId Condition="'$(RuntimeIdentifier)' == 'linux-musl-arm64'">alpine-3.17-arm64</AotAnywhereLinuxSysrootId>
    <AotAnywhereLinuxSysrootId Condition="'$(RuntimeIdentifier)' == 'linux-musl-arm'">alpine-3.17-arm</AotAnywhereLinuxSysrootId>

    <!-- Cross-compiling to Windows: skip the ILC targets' vcvarsall probe (a
         Windows batch file). The link itself is taken over by the
         AotAnywhereWindowsLink task (DirectLink.targets), so CppLinker is never
         invoked - no MSVC and no link shim needed. -->
    <_AotAnywhereWindowsCross>false</_AotAnywhereWindowsCross>
    <_AotAnywhereWindowsCross Condition="$(RuntimeIdentifier.StartsWith('win')) and !$([MSBuild]::IsOSPlatform('Windows'))">true</_AotAnywhereWindowsCross>
    <IlcUseEnvironmentalTools Condition="'$(_AotAnywhereWindowsCross)' == 'true'">true</IlcUseEnvironmentalTools>
  </PropertyGroup>

  <!-- NuGet does not restore PackageReferences introduced by an installed
       package's build targets (NuGet/Home#4790). Sdk/Sdk.props declares the
       same references during a consumer's first restore; these remain for
       plain-PackageReference consumers on a subsequent restore or warm cache. -->
  <ItemGroup>
    <PackageReference Include="StuDev.AotAnywhere.Clang.Toolsets.$(HostRuntimeIdentifier)"
      Version="$(AotAnywhereClangToolsetVersion)"
      PrivateAssets="all"
      IsImplicitlyDefined="true"
      GeneratePathProperty="true"
      Condition="'$(UseExternalClang)' == 'false' and '$(_AotAnywhereToolchainRefsViaSdk)' != 'true'" />
    <PackageReference Include="StuDev.AotAnywhere.Linux.Sysroots.$(AotAnywhereLinuxSysrootId)"
      Version="$(AotAnywhereLinuxSysrootVersion)"
      PrivateAssets="all"
      IsImplicitlyDefined="true"
      GeneratePathProperty="true"
      Condition="'$(UseExternalClang)' == 'false' and '$(_AotAnywhereToolchainRefsViaSdk)' != 'true' and ('$(AotAnywhereLinuxSysrootId)' != 'alpine-3.17-arm' or '$(AotAnywhereLinuxMuslArmSysrootAvailable)' == 'true')" />
    <PackageReference Include="StuDev.AotAnywhere.Windows.CrossLink"
      Version="$(AotAnywhereWindowsCrossLinkVersion)"
      PrivateAssets="all"
      IsImplicitlyDefined="true"
      GeneratePathProperty="true"
      Condition="'$(UseExternalClang)' == 'false' and '$(_AotAnywhereToolchainRefsViaSdk)' != 'true' and '$(AotAnywhereWindowsCrossLinkAvailable)' == 'true' and $(RuntimeIdentifier.StartsWith('win')) and !$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <!-- Cross-compiling to macOS needs Apple linker stubs (.tbd files). The
       package ships a minimal, self-generated set covering exactly the
       symbols .NET's runtime packs reference; the macOS link takeover
       (AotAnywhereDirectLinkMacNative) reads $(AotAnywhereAppleSysroot) unless
       the user supplied their own sysroot (via the AotAnywhereAppleSysroot
       property or the AOTANYWHERE_APPLE_SYSROOT environment variable). -->
  <Target Name="SetAppleSysroot"
          BeforeTargets="SetupOSSpecificProps"
          Condition="$(RuntimeIdentifier.StartsWith('osx')) and !$([MSBuild]::IsOSPlatform('OSX'))">

    <PropertyGroup>
      <AotAnywhereAppleSysroot Condition="'$(AotAnywhereAppleSysroot)' == ''">$(AOTANYWHERE_APPLE_SYSROOT)</AotAnywhereAppleSysroot>
      <AotAnywhereAppleSysroot Condition="'$(AotAnywhereAppleSysroot)' == ''">$(MSBuildThisFileDirectory)apple-sysroot</AotAnywhereAppleSysroot>
    </PropertyGroup>

  </Target>

  <UsingTask TaskName="PrependPath"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">

    <ParameterGroup>
      <Value ParameterType="System.String" Required="true" />
    </ParameterGroup>

    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          Environment.SetEnvironmentVariable("PATH", Value + Path.PathSeparator + Environment.GetEnvironmentVariable("PATH"));
        ]]>
      </Code>
    </Task>

  </UsingTask>

  <UsingTask TaskName="ResolveLinuxGccLibrary"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sysroot ParameterType="System.String" Required="true" />
      <TargetTriple ParameterType="System.String" Required="true" />
      <LibraryDirectory ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          foreach (var root in new[] { Path.Combine(Sysroot, "usr", "lib", "gcc"), Path.Combine(Sysroot, "usr", "lib64", "gcc") })
          {
              if (!Directory.Exists(root)) continue;
              var target = Directory.EnumerateDirectories(root, TargetTriple + "*")
                  .OrderBy(path => path, StringComparer.Ordinal).FirstOrDefault();
              if (target == null) continue;
              LibraryDirectory = Directory.EnumerateDirectories(target)
                  .OrderBy(path => path, StringComparer.Ordinal).FirstOrDefault();
              if (LibraryDirectory != null) return true;
          }
          Log.LogError($"AotAnywhere: no GCC support-library directory for '{TargetTriple}' exists under Linux sysroot '{Sysroot}'.");
          return false;
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- The ILC Unix targets probe CppLinker and ObjCopyName before the direct
       link takeover runs. Point them at real Clang/LLVM tools so the probes
       observe exactly what the link flows will execute. Windows where /Q cannot
       probe a drive-letter path, so only Windows hosts need a scoped PATH prepend. -->
  <Target Name="PointLinkerToClang"
          DependsOnTargets="SetPathToClang"
          BeforeTargets="SetupOSSpecificProps">

    <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows')) and !$(RuntimeIdentifier.StartsWith('win'))">
      <CppLinker>$(AotAnywhereClangExe)</CppLinker>
      <ObjCopyName Condition="$(RuntimeIdentifier.StartsWith('linux'))">$(AotAnywhereLlvmObjcopyExe)</ObjCopyName>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and !$(RuntimeIdentifier.StartsWith('win'))">
      <CppLinker>clang</CppLinker>
      <ObjCopyName Condition="$(RuntimeIdentifier.StartsWith('linux'))">llvm-objcopy</ObjCopyName>
    </PropertyGroup>

    <PrependPath Condition="$([MSBuild]::IsOSPlatform('Windows')) and !$(RuntimeIdentifier.StartsWith('win')) and '$(AotAnywhereClangBinPath)' != ''" Value="$(AotAnywhereClangBinPath)" />

  </Target>

  <Target Name="SetPathToClang"
          BeforeTargets="SetupOSSpecificProps">

    <Error Condition="$(HostRuntimeIdentifier.StartsWith('win-x86'))"
           Text="AotAnywhere: Windows x86 is no longer a supported build host for Clang cross-compilation. Use a Windows x64 or Windows ARM64 host." />

    <PropertyGroup Condition="$(HostRuntimeIdentifier.StartsWith('win-'))">
      <AotAnywhereClangToolsetPath Condition="$(HostRuntimeIdentifier.EndsWith('-x64'))">$(PkgStuDev_AotAnywhere_Clang_Toolsets_win-x64)/tools</AotAnywhereClangToolsetPath>
      <AotAnywhereClangToolsetPath Condition="$(HostRuntimeIdentifier.EndsWith('-arm64'))">$(PkgStuDev_AotAnywhere_Clang_Toolsets_win-arm64)/tools</AotAnywhereClangToolsetPath>
    </PropertyGroup>

    <PropertyGroup Condition="$(HostRuntimeIdentifier.StartsWith('osx-'))">
      <AotAnywhereClangToolsetPath Condition="$(HostRuntimeIdentifier.EndsWith('-x64'))">$(PkgStuDev_AotAnywhere_Clang_Toolsets_osx-x64)/tools</AotAnywhereClangToolsetPath>
      <AotAnywhereClangToolsetPath Condition="$(HostRuntimeIdentifier.EndsWith('-arm64'))">$(PkgStuDev_AotAnywhere_Clang_Toolsets_osx-arm64)/tools</AotAnywhereClangToolsetPath>
    </PropertyGroup>

    <PropertyGroup Condition="$(HostRuntimeIdentifier.StartsWith('linux-'))">
      <AotAnywhereClangToolsetPath Condition="$(HostRuntimeIdentifier.EndsWith('-x64'))">$(PkgStuDev_AotAnywhere_Clang_Toolsets_linux-x64)/tools</AotAnywhereClangToolsetPath>
      <AotAnywhereClangToolsetPath Condition="$(HostRuntimeIdentifier.EndsWith('-arm64'))">$(PkgStuDev_AotAnywhere_Clang_Toolsets_linux-arm64)/tools</AotAnywhereClangToolsetPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(UseExternalClang)' == 'false' and !Exists('$(AotAnywhereClangToolsetPath)') and '$(NuGetPackageRoot)' != ''">
      <_AotAnywhereClangToolsetCacheDir>$([MSBuild]::NormalizeDirectory('$(NuGetPackageRoot)', 'studev.aotanywhere.clang.toolsets.$(HostRuntimeIdentifier.ToLowerInvariant())', '$(AotAnywhereClangToolsetVersion)', 'tools'))</_AotAnywhereClangToolsetCacheDir>
      <AotAnywhereClangToolsetPath Condition="Exists('$(_AotAnywhereClangToolsetCacheDir)')">$(_AotAnywhereClangToolsetCacheDir)</AotAnywhereClangToolsetPath>
    </PropertyGroup>

    <Error Condition="'$(UseExternalClang)' == 'false' and !Exists('$(AotAnywhereClangToolsetPath)')"
           Text="AotAnywhere: the Clang toolset ('StuDev.AotAnywhere.Clang.Toolsets.$(HostRuntimeIdentifier)' $(AotAnywhereClangToolsetVersion)) was not restored. NuGet cannot restore package references declared inside a package's build targets, so use an MSBuild SDK reference for a clean first restore, add the toolset PackageReference explicitly, or set UseExternalClang=true with AotAnywhereClangPath or clang on PATH." />

    <PropertyGroup>
      <AotAnywhereClangBinPath Condition="'$(UseExternalClang)' != 'true'">$(AotAnywhereClangToolsetPath)/bin</AotAnywhereClangBinPath>
      <AotAnywhereClangBinPath Condition="'$(UseExternalClang)' == 'true' and '$(AotAnywhereClangBinPath)' == '' and '$(AotAnywhereClangPath)' != ''">$(AotAnywhereClangPath)/bin</AotAnywhereClangBinPath>
      <AotAnywhereClangExe Condition="'$(AotAnywhereClangExe)' == ''">clang</AotAnywhereClangExe>
      <AotAnywhereLldLinkExe Condition="'$(AotAnywhereLldLinkExe)' == ''">lld-link</AotAnywhereLldLinkExe>
      <AotAnywhereLd64LldExe Condition="'$(AotAnywhereLd64LldExe)' == ''">ld64.lld</AotAnywhereLd64LldExe>
      <AotAnywhereLlvmObjcopyExe Condition="'$(AotAnywhereLlvmObjcopyExe)' == ''">llvm-objcopy</AotAnywhereLlvmObjcopyExe>
      <AotAnywhereClangExe Condition="'$(AotAnywhereClangBinPath)' != ''">$(AotAnywhereClangBinPath)/clang</AotAnywhereClangExe>
      <AotAnywhereLldLinkExe Condition="'$(AotAnywhereClangBinPath)' != ''">$(AotAnywhereClangBinPath)/lld-link</AotAnywhereLldLinkExe>
      <AotAnywhereLd64LldExe Condition="'$(AotAnywhereClangBinPath)' != ''">$(AotAnywhereClangBinPath)/ld64.lld</AotAnywhereLd64LldExe>
      <AotAnywhereLlvmObjcopyExe Condition="'$(AotAnywhereClangBinPath)' != ''">$(AotAnywhereClangBinPath)/llvm-objcopy</AotAnywhereLlvmObjcopyExe>
      <AotAnywhereClangExe Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(AotAnywhereClangBinPath)' != ''">$(AotAnywhereClangBinPath)/clang.exe</AotAnywhereClangExe>
      <AotAnywhereLldLinkExe Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(AotAnywhereClangBinPath)' != ''">$(AotAnywhereClangBinPath)/lld-link.exe</AotAnywhereLldLinkExe>
      <AotAnywhereLd64LldExe Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(AotAnywhereClangBinPath)' != ''">$(AotAnywhereClangBinPath)/ld64.lld.exe</AotAnywhereLd64LldExe>
      <AotAnywhereLlvmObjcopyExe Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(AotAnywhereClangBinPath)' != ''">$(AotAnywhereClangBinPath)/llvm-objcopy.exe</AotAnywhereLlvmObjcopyExe>
    </PropertyGroup>

  </Target>

  <Target Name="SetLinuxSysroot"
          DependsOnTargets="SetPathToClang"
          Condition="$(RuntimeIdentifier.StartsWith('linux'))">

    <PropertyGroup>
      <AotAnywhereLinuxSysroot Condition="'$(AotAnywhereLinuxSysroot)' == '' and '$(UseExternalClang)' != 'true' and '$(AotAnywhereLinuxSysrootId)' == 'ubuntu-18.04-amd64'">$(PkgStuDev_AotAnywhere_Linux_Sysroots_ubuntu-18_04-amd64)/tools/sysroot</AotAnywhereLinuxSysroot>
      <AotAnywhereLinuxSysroot Condition="'$(AotAnywhereLinuxSysroot)' == '' and '$(UseExternalClang)' != 'true' and '$(AotAnywhereLinuxSysrootId)' == 'ubuntu-18.04-arm64'">$(PkgStuDev_AotAnywhere_Linux_Sysroots_ubuntu-18_04-arm64)/tools/sysroot</AotAnywhereLinuxSysroot>
      <AotAnywhereLinuxSysroot Condition="'$(AotAnywhereLinuxSysroot)' == '' and '$(UseExternalClang)' != 'true' and '$(AotAnywhereLinuxSysrootId)' == 'ubuntu-22.04-arm'">$(PkgStuDev_AotAnywhere_Linux_Sysroots_ubuntu-22_04-arm)/tools/sysroot</AotAnywhereLinuxSysroot>
      <AotAnywhereLinuxSysroot Condition="'$(AotAnywhereLinuxSysroot)' == '' and '$(UseExternalClang)' != 'true' and '$(AotAnywhereLinuxSysrootId)' == 'alpine-3.17-amd64'">$(PkgStuDev_AotAnywhere_Linux_Sysroots_alpine-3_17-amd64)/tools/sysroot</AotAnywhereLinuxSysroot>
      <AotAnywhereLinuxSysroot Condition="'$(AotAnywhereLinuxSysroot)' == '' and '$(UseExternalClang)' != 'true' and '$(AotAnywhereLinuxSysrootId)' == 'alpine-3.17-arm64'">$(PkgStuDev_AotAnywhere_Linux_Sysroots_alpine-3_17-arm64)/tools/sysroot</AotAnywhereLinuxSysroot>
      <AotAnywhereLinuxSysroot Condition="'$(AotAnywhereLinuxSysroot)' == '' and '$(UseExternalClang)' != 'true' and '$(AotAnywhereLinuxSysrootId)' == 'alpine-3.17-arm' and '$(AotAnywhereLinuxMuslArmSysrootAvailable)' == 'true'">$(PkgStuDev_AotAnywhere_Linux_Sysroots_alpine-3_17-arm)/tools/sysroot</AotAnywhereLinuxSysroot>

      <_AotAnywhereLinuxSysrootCacheDir Condition="'$(AotAnywhereLinuxSysrootId)' != 'alpine-3.17-arm' or '$(AotAnywhereLinuxMuslArmSysrootAvailable)' == 'true'">$([MSBuild]::NormalizeDirectory('$(NuGetPackageRoot)', 'studev.aotanywhere.linux.sysroots.$(AotAnywhereLinuxSysrootId)', '$(AotAnywhereLinuxSysrootVersion)', 'tools', 'sysroot'))</_AotAnywhereLinuxSysrootCacheDir>
      <AotAnywhereLinuxSysroot Condition="'$(AotAnywhereLinuxSysroot)' == '' and Exists('$(_AotAnywhereLinuxSysrootCacheDir)')">$(_AotAnywhereLinuxSysrootCacheDir)</AotAnywhereLinuxSysroot>
      <AotAnywhereLinuxGccTarget Condition="'$(AotAnywhereLinuxGccTarget)' == ''">$(TargetTriple)</AotAnywhereLinuxGccTarget>
      <!-- Alpine's GCC layouts include the distribution name, unlike the Clang
           target triples used to link each musl RID. -->
      <AotAnywhereLinuxGccTarget Condition="'$(RuntimeIdentifier)' == 'linux-musl-x64'">x86_64-alpine-linux-musl</AotAnywhereLinuxGccTarget>
      <AotAnywhereLinuxGccTarget Condition="'$(RuntimeIdentifier)' == 'linux-musl-arm64'">aarch64-alpine-linux-musl</AotAnywhereLinuxGccTarget>
      <AotAnywhereLinuxGccTarget Condition="'$(RuntimeIdentifier)' == 'linux-musl-arm'">armv7-alpine-linux-musleabihf</AotAnywhereLinuxGccTarget>
    </PropertyGroup>

    <Error Condition="'$(AotAnywhereLinuxSysroot)' == ''"
           Text="AotAnywhere: no Linux sysroot is configured for '$(RuntimeIdentifier)'. Use the MSBuild SDK reference to restore 'StuDev.AotAnywhere.Linux.Sysroots.$(AotAnywhereLinuxSysrootId)', add that PackageReference explicitly, or set AotAnywhereLinuxSysroot to a compatible sysroot." />
    <Error Condition="!Exists('$(AotAnywhereLinuxSysroot)/usr')"
           Text="AotAnywhere: Linux sysroot '$(AotAnywhereLinuxSysroot)' is missing its usr directory." />

    <ResolveLinuxGccLibrary Sysroot="$(AotAnywhereLinuxSysroot)"
                            TargetTriple="$(AotAnywhereLinuxGccTarget)">
      <Output TaskParameter="LibraryDirectory" PropertyName="AotAnywhereLinuxGccLibraryDirectory" />
    </ResolveLinuxGccLibrary>

  </Target>

  <Target Name="SetWindowsCrossLinkPaths"
          Condition="'$(_AotAnywhereWindowsCross)' == 'true'">

    <PropertyGroup>
      <AotAnywhereWindowsCrossLinkPath Condition="'$(AotAnywhereWindowsCrossLinkPath)' == '' and '$(UseExternalClang)' != 'true' and '$(AotAnywhereWindowsCrossLinkAvailable)' == 'true'">$(PkgStuDev_AotAnywhere_Windows_CrossLink)/tools</AotAnywhereWindowsCrossLinkPath>
      <_AotAnywhereWindowsCrossLinkCacheDir Condition="'$(AotAnywhereWindowsCrossLinkAvailable)' == 'true'">$([MSBuild]::NormalizeDirectory('$(NuGetPackageRoot)', 'studev.aotanywhere.windows.crosslink', '$(AotAnywhereWindowsCrossLinkVersion)', 'tools'))</_AotAnywhereWindowsCrossLinkCacheDir>
      <AotAnywhereWindowsCrossLinkPath Condition="'$(AotAnywhereWindowsCrossLinkPath)' == '' and Exists('$(_AotAnywhereWindowsCrossLinkCacheDir)')">$(_AotAnywhereWindowsCrossLinkCacheDir)</AotAnywhereWindowsCrossLinkPath>
      <AotAnywhereMsvcPath Condition="'$(AotAnywhereMsvcPath)' == '' and '$(AotAnywhereWindowsCrossLinkPath)' != ''">$(AotAnywhereWindowsCrossLinkPath)/vctools</AotAnywhereMsvcPath>
      <AotAnywhereWindowsSdkPath Condition="'$(AotAnywhereWindowsSdkPath)' == '' and '$(AotAnywhereWindowsCrossLinkPath)' != ''">$(AotAnywhereWindowsCrossLinkPath)/winsdk</AotAnywhereWindowsSdkPath>
    </PropertyGroup>

    <Error Condition="'$(AotAnywhereWindowsCrossLinkAvailable)' != 'true' and ('$(AotAnywhereMsvcPath)' == '' or '$(AotAnywhereWindowsSdkPath)' == '')"
              Text="AotAnywhere: non-Windows Windows-target links require external MSVC and Windows SDK library roots. Run eng/export-windows-crosslink.ps1 on a licensed Windows install, restore with eng/import-windows-crosslink.ps1, then set both AotAnywhereMsvcPath and AotAnywhereWindowsSdkPath (see docs/windows-crosslink-cache.md)." />
    <Error Condition="'$(AotAnywhereWindowsCrossLinkAvailable)' == 'true' and !Exists('$(AotAnywhereMsvcPath)/lib')"
          Text="AotAnywhere: MSVC cross-link libraries were not restored. Use the MSBuild SDK reference to restore StuDev.AotAnywhere.Windows.CrossLink, add that PackageReference explicitly, or set AotAnywhereMsvcPath." />
    <Error Condition="'$(AotAnywhereWindowsCrossLinkAvailable)' == 'true' and !Exists('$(AotAnywhereWindowsSdkPath)/Lib')"
          Text="AotAnywhere: Windows SDK cross-link libraries were not restored. Set AotAnywhereWindowsSdkPath to a compatible Windows SDK root." />

  </Target>

  <!-- BEGIN: Works around ILCompiler targets not detecting this as a cross compilation -->
  <Target Name="OverwriteTargetTriple"
          AfterTargets="SetupOSSpecificProps"
          BeforeTargets="LinkNative">

    <PropertyGroup>
      <CrossCompileRid />
      <CrossCompileRid>$(RuntimeIdentifier)</CrossCompileRid>

      <CrossCompileArch />
      <CrossCompileArch Condition="$(CrossCompileRid.EndsWith('-x64'))">x86_64</CrossCompileArch>
      <CrossCompileArch Condition="$(CrossCompileRid.EndsWith('-arm64'))">aarch64</CrossCompileArch>
      <CrossCompileArch Condition="$(CrossCompileRid.EndsWith('-arm'))">arm</CrossCompileArch>

      <!-- armv7 (linux-arm, linux-musl-arm) uses the hard-float ABI, which
           the triple carries as a suffix: arm-linux-gnueabihf /
           arm-linux-musleabihf. The 64-bit triples have no such suffix. -->
      <CrossCompileAbiSuffix />
      <CrossCompileAbiSuffix Condition="'$(CrossCompileArch)' == 'arm'">eabihf</CrossCompileAbiSuffix>

      <TargetTriple />
      <TargetTriple Condition="'$(CrossCompileArch)' != '' and $(CrossCompileRid.StartsWith('linux'))">$(CrossCompileArch)-linux-gnu$(CrossCompileAbiSuffix)</TargetTriple>
      <TargetTriple Condition="'$(CrossCompileArch)' != '' and ($(CrossCompileRid.StartsWith('linux-musl')) or $(CrossCompileRid.StartsWith('alpine')))">$(CrossCompileArch)-linux-musl$(CrossCompileAbiSuffix)</TargetTriple>
      <TargetTriple Condition="'$(CrossCompileArch)' != '' and $(CrossCompileRid.StartsWith('osx'))">$(CrossCompileArch)-macos</TargetTriple>
      <TargetTriple Condition="'$(CrossCompileArch)' != '' and $(CrossCompileRid.StartsWith('win'))">$(CrossCompileArch)-windows-msvc</TargetTriple>

      <!-- StripSymbols keeps the SDK's Unix default (true) for macOS targets.
           Apple's strip/dsymutil are unavailable on Linux/Windows hosts, but
           the SDK's dsymutil+strip step lives
           inside LinkNative, which the DirectLink takeover pre-satisfies;
           the strip itself happens at link time via ld64's -x in
           _AotAnywhereComputeMacLinkArgs. The SDK's Apple stripper probes in
           SetupOSSpecificProps are IgnoreExitCode Execs whose Errors only
           fire for non-Apple platforms, so StripSymbols=true is safe on
           mac-less hosts too. -->
    </PropertyGroup>

    <Error Condition="'$(_AotAnywhereWindowsCross)' == 'true' and '$(CrossCompileArch)' == ''"
           Text="AotAnywhere: cross-compiling to '$(RuntimeIdentifier)' is not supported; of the Windows targets only win-x64 and win-arm64 are." />

    <ItemGroup>
      <!-- lld-link consumes the SDK's native MSVC arguments directly for
           Windows targets; only Clang driver links need a target argument. -->
      <LinkerArg Include="--target=$(TargetTriple)" Condition="!$(CrossCompileRid.StartsWith('win'))" />
    </ItemGroup>

  </Target>
  <!-- END: Works around ILCompiler targets not detecting this as a cross compilation -->

  <!-- Direct Clang invocation is the Linux link flow; see DirectLink.targets. -->
  <Import Project="$(MSBuildThisFileDirectory)DirectLink.targets" />

  <!-- The SDK's _CopyAotSymbols assumes the host and target symbol layouts
       match: on Windows hosts it looks for $(TargetName)$(NativeSymbolExt)
       (the MSVC .pdb shape), but a Unix shared library's sidecar is named
       $(TargetName)$(NativeBinaryExt)$(NativeSymbolExt) - HelloLib.so.dbg -
       so from a Windows host it never reaches the publish directory.
       Executables are unaffected (their NativeBinaryExt is empty). Copy the
       sidecar ourselves after _CopyAotSymbols has run. -->
  <Target Name="AotAnywhereCopySharedLibrarySymbols"
          AfterTargets="_CopyAotSymbols"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) and !$(RuntimeIdentifier.StartsWith('win')) and '$(NativeBinaryExt)' != '' and '$(CopyOutputSymbolsToPublishDirectory)' != 'false' and Exists('$(NativeBinary)$(NativeSymbolExt)')">

    <Copy SourceFiles="$(NativeBinary)$(NativeSymbolExt)" DestinationFolder="$(PublishDir)" />

  </Target>

  <!-- For Windows targets lld writes $(TargetName).pdb next to the binary
       (the name the PE's CodeView record references), but the SDK's
       _CopyAotSymbols only knows MSVC's host-Windows layout and misses it.
       Copy it to the publish directory ourselves, after _CopyAotSymbols has
       finished deleting the managed .pdb it replaces. -->
  <Target Name="AotAnywhereCopyWindowsPdb"
          AfterTargets="_CopyAotSymbols"
          Condition="'$(_AotAnywhereWindowsCross)' == 'true' and '$(CopyOutputSymbolsToPublishDirectory)' != 'false' and Exists('$(NativeOutputPath)$(TargetName).pdb')">

    <Copy SourceFiles="$(NativeOutputPath)$(TargetName).pdb" DestinationFolder="$(PublishDir)" />

  </Target>

  <!-- Cross-linked macOS binaries carry an ad-hoc code signature for local
       execution but it is not suitable for distribution. This re-signs the linked
       binary with a real identity, from any host:
         - AotAnywhereSignP12File / AotAnywhereSignP12PasswordFile:
           sign with a Developer ID certificate using rcodesign
           (https://github.com/indygreg/apple-platform-rs), works on
           Windows/Linux/macOS hosts
         - AotAnywhereCodesignIdentity: sign with Apple's codesign,
           macOS hosts only (takes precedence there when both are set)
       Both paths apply the hardened-runtime flag and a secure timestamp so
       the result is ready for notarization. -->
  <Target Name="SignMacOsBinary"
          AfterTargets="LinkNative"
          Condition="$(RuntimeIdentifier.StartsWith('osx'))">

    <PropertyGroup>
      <AotAnywhereRCodesignPath Condition="'$(AotAnywhereRCodesignPath)' == ''">rcodesign</AotAnywhereRCodesignPath>

      <_UseCodesign>false</_UseCodesign>
      <_UseCodesign Condition="'$(AotAnywhereCodesignIdentity)' != '' and $([MSBuild]::IsOSPlatform('OSX'))">true</_UseCodesign>
      <_UseRCodesign>false</_UseRCodesign>
      <_UseRCodesign Condition="'$(_UseCodesign)' != 'true' and '$(AotAnywhereSignP12File)' != ''">true</_UseRCodesign>

      <!-- Timestamping needs a real certificate; skip it for the ad-hoc
           identity so /p:AotAnywhereCodesignIdentity=- also works. -->
      <_CodesignTimestampArg>--timestamp</_CodesignTimestampArg>
      <_CodesignTimestampArg Condition="'$(AotAnywhereCodesignIdentity)' == '-'">--timestamp=none</_CodesignTimestampArg>

      <_CodesignEntitlementsArg Condition="'$(AotAnywhereEntitlements)' != ''">--entitlements &quot;$(AotAnywhereEntitlements)&quot;</_CodesignEntitlementsArg>
      <!-- -e is the stable alias: the long form was renamed from
           entitlements-xml-path to entitlements-xml-file across rcodesign releases. -->
      <_RCodesignEntitlementsArg Condition="'$(AotAnywhereEntitlements)' != ''">-e &quot;$(AotAnywhereEntitlements)&quot;</_RCodesignEntitlementsArg>
    </PropertyGroup>

    <Message Importance="high"
             Condition="'$(_UseCodesign)' != 'true' and '$(_UseRCodesign)' != 'true' and '$(AotAnywhereCodesignIdentity)' == ''"
             Text="AotAnywhere: the produced binary carries only an ad-hoc code signature. It runs locally, but to distribute it sign with a Developer ID certificate: set AotAnywhereSignP12File (any host) or AotAnywhereCodesignIdentity (macOS hosts). See the README for details." />

    <Error Condition="'$(AotAnywhereCodesignIdentity)' != '' and '$(_UseCodesign)' != 'true' and '$(_UseRCodesign)' != 'true'"
           Text="AotAnywhereCodesignIdentity uses Apple's codesign, which only exists on macOS hosts. On this host set AotAnywhereSignP12File and AotAnywhereSignP12PasswordFile to sign with rcodesign instead." />
    <Error Condition="'$(_UseRCodesign)' == 'true' and !Exists('$(AotAnywhereSignP12File)')"
           Text="AotAnywhereSignP12File '$(AotAnywhereSignP12File)' does not exist." />
    <Error Condition="'$(_UseRCodesign)' == 'true' and '$(AotAnywhereSignP12PasswordFile)' == ''"
           Text="Set AotAnywhereSignP12PasswordFile to a file containing the .p12 password. It is a file (not a plain property) so the password does not end up in build logs; rcodesign would otherwise prompt for it and hang the build." />
    <Error Condition="'$(_UseRCodesign)' == 'true' and '$(AotAnywhereSignP12PasswordFile)' != '' and !Exists('$(AotAnywhereSignP12PasswordFile)')"
           Text="AotAnywhereSignP12PasswordFile '$(AotAnywhereSignP12PasswordFile)' does not exist." />
    <Error Condition="'$(AotAnywhereEntitlements)' != '' and !Exists('$(AotAnywhereEntitlements)')"
           Text="AotAnywhereEntitlements '$(AotAnywhereEntitlements)' does not exist." />

    <!-- Probe for rcodesign first to fail with instructions instead of a
         cryptic 'command not found'. -->
    <Exec Condition="'$(_UseRCodesign)' == 'true'"
          Command="&quot;$(AotAnywhereRCodesignPath)&quot; --version"
          IgnoreExitCode="true"
          EchoOff="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_RCodesignProbeExitCode" />
    </Exec>
    <Error Condition="'$(_UseRCodesign)' == 'true' and '$(_RCodesignProbeExitCode)' != '0'"
           Text="rcodesign was not found at '$(AotAnywhereRCodesignPath)'. Install it from https://github.com/indygreg/apple-platform-rs/releases (or 'cargo install apple-codesign'), or point AotAnywhereRCodesignPath at the executable." />

    <Message Importance="high" Condition="'$(_UseCodesign)' == 'true'"
             Text="Signing $(NativeBinary) with codesign identity '$(AotAnywhereCodesignIdentity)'" />
    <Exec Condition="'$(_UseCodesign)' == 'true'"
          Command="codesign --force --options runtime $(_CodesignTimestampArg) $(_CodesignEntitlementsArg) --sign &quot;$(AotAnywhereCodesignIdentity)&quot; &quot;$(NativeBinary)&quot;" />

    <Message Importance="high" Condition="'$(_UseRCodesign)' == 'true'"
             Text="Signing $(NativeBinary) with rcodesign using '$(AotAnywhereSignP12File)'" />
    <Exec Condition="'$(_UseRCodesign)' == 'true'"
          Command="&quot;$(AotAnywhereRCodesignPath)&quot; sign --p12-file &quot;$(AotAnywhereSignP12File)&quot; --p12-password-file &quot;$(AotAnywhereSignP12PasswordFile)&quot; --code-signature-flags runtime $(_RCodesignEntitlementsArg) &quot;$(NativeBinary)&quot;" />

  </Target>

  <!-- Opt-in notarization (AotAnywhereNotarize=true): zips the signed
       binary and submits it to Apple's notary service with rcodesign, waiting
       for the verdict. Needs an App Store Connect API key encoded with
       'rcodesign encode-app-store-connect-api-key' and a Developer ID
       signature (Apple rejects ad-hoc or self-signed submissions). The zip is
       only a submission container; distribute the binary itself — Gatekeeper
       fetches the notarization ticket online, since bare executables cannot
       be stapled. -->
  <Target Name="NotarizeMacOsBinary"
          AfterTargets="SignMacOsBinary"
          Condition="$(RuntimeIdentifier.StartsWith('osx')) and '$(AotAnywhereNotarize)' == 'true'">

    <PropertyGroup>
      <AotAnywhereRCodesignPath Condition="'$(AotAnywhereRCodesignPath)' == ''">rcodesign</AotAnywhereRCodesignPath>
      <_NotaryStagingDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'aotanywhere', 'notary'))</_NotaryStagingDir>
      <_NotaryZip>$(_NotaryStagingDir)$(TargetName).zip</_NotaryZip>
    </PropertyGroup>

    <Error Condition="'$(AotAnywhereSignP12File)' == '' and ('$(AotAnywhereCodesignIdentity)' == '' or '$(AotAnywhereCodesignIdentity)' == '-')"
           Text="AotAnywhereNotarize requires signing with a Developer ID certificate in the same publish; set AotAnywhereSignP12File or AotAnywhereCodesignIdentity. Apple rejects ad-hoc signed submissions." />
    <Error Condition="'$(AotAnywhereNotaryApiKeyFile)' == ''"
           Text="Set AotAnywhereNotaryApiKeyFile to an App Store Connect API key encoded with 'rcodesign encode-app-store-connect-api-key'." />
    <Error Condition="'$(AotAnywhereNotaryApiKeyFile)' != '' and !Exists('$(AotAnywhereNotaryApiKeyFile)')"
           Text="AotAnywhereNotaryApiKeyFile '$(AotAnywhereNotaryApiKeyFile)' does not exist." />

    <Exec Command="&quot;$(AotAnywhereRCodesignPath)&quot; --version"
          IgnoreExitCode="true"
          EchoOff="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_RCodesignNotaryProbeExitCode" />
    </Exec>
    <Error Condition="'$(_RCodesignNotaryProbeExitCode)' != '0'"
           Text="rcodesign was not found at '$(AotAnywhereRCodesignPath)'; it is required for notarization. Install it from https://github.com/indygreg/apple-platform-rs/releases (or 'cargo install apple-codesign'), or point AotAnywhereRCodesignPath at the executable." />

    <!-- Stage into a directory holding just the binary so the zip contains a
         single root entry. -->
    <RemoveDir Directories="$(_NotaryStagingDir)" />
    <MakeDir Directories="$(_NotaryStagingDir)bin" />
    <Copy SourceFiles="$(NativeBinary)" DestinationFolder="$(_NotaryStagingDir)bin" />
    <ZipDirectory SourceDirectory="$(_NotaryStagingDir)bin" DestinationFile="$(_NotaryZip)" Overwrite="true" />

    <Message Importance="high" Text="Submitting $(NativeBinary) to Apple's notary service (this waits for the verdict and can take a few minutes)" />
    <Exec Command="&quot;$(AotAnywhereRCodesignPath)&quot; notary-submit --api-key-file &quot;$(AotAnywhereNotaryApiKeyFile)&quot; --wait &quot;$(_NotaryZip)&quot;" />
    <Message Importance="high" Text="Notarization accepted. Distribute the binary as-is: Gatekeeper fetches the ticket online on first run (bare executables cannot be stapled)." />

  </Target>

</Project>
