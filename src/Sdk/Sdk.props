<Project>

  <!-- MSBuild SDK consumption (<Sdk Name="StuDev.AotAnywhere" Version="..." />).

       This entry point exists because NuGet cannot restore a PackageReference
       declared inside a package's build/ targets (NuGet/Home#4790): consumed as
       a plain PackageReference, the Clang toolset and sysroot references in
       Crosscompile.targets are invisible to restore, so on a clean machine the
       cross toolchain is never fetched and the link fails. SDK props, by contrast, ARE
       evaluated during restore — so the references below land in the restore
       graph and everything is fetched first time.

       This file only injects references. All real logic still lives in
       build/StuDev.AotAnywhere.targets, pulled in through the self
       PackageReference below, so import order matches plain-PackageReference
       consumption exactly. -->

  <PropertyGroup>
    <!-- Replaced with the real package version at pack time (BakeSdkProps in
         AotAnywhere.nuproj). Overridable so the SDK reference and the package
         version can be pinned independently if ever needed. -->
    <AotAnywherePackageVersion Condition="'$(AotAnywherePackageVersion)' == ''">__AOTANYWHERE_PACKAGE_VERSION__</AotAnywherePackageVersion>

    <!-- On the very first restore the package's build/ targets (which import
         ClangToolchainVersion.props) are not imported yet, so the content
         package versions must be known
         here too. Rather than duplicate the literal, it is baked in at pack
         time from the single ClangToolchainVersion.props pins (BakeSdkProps in
         the nuproj substitutes the placeholders below). -->
    <AotAnywhereClangToolsetVersion Condition="'$(AotAnywhereClangToolsetVersion)' == ''">__AOTANYWHERE_CLANG_TOOLSET_VERSION__</AotAnywhereClangToolsetVersion>
    <AotAnywhereLinuxSysrootVersion Condition="'$(AotAnywhereLinuxSysrootVersion)' == ''">__AOTANYWHERE_LINUX_SYSROOT_VERSION__</AotAnywhereLinuxSysrootVersion>
    <AotAnywhereWindowsCrossLinkVersion Condition="'$(AotAnywhereWindowsCrossLinkVersion)' == ''">__AOTANYWHERE_WINDOWS_CROSS_LINK_VERSION__</AotAnywhereWindowsCrossLinkVersion>
    <AotAnywhereArmv7SysrootsAvailable Condition="'$(AotAnywhereArmv7SysrootsAvailable)' == ''">__AOTANYWHERE_ARMV7_SYSROOTS_AVAILABLE__</AotAnywhereArmv7SysrootsAvailable>
    <AotAnywhereWindowsCrossLinkAvailable Condition="'$(AotAnywhereWindowsCrossLinkAvailable)' == ''">__AOTANYWHERE_WINDOWS_CROSS_LINK_AVAILABLE__</AotAnywhereWindowsCrossLinkAvailable>
    <HostRuntimeIdentifier Condition="'$(HostRuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</HostRuntimeIdentifier>

    <!-- Tells Crosscompile.targets its own restore-invisible references are
         superseded by the restore-visible ones below. -->
    <_AotAnywhereToolchainRefsViaSdk>true</_AotAnywhereToolchainRefsViaSdk>

    <AotAnywhereLinuxSysrootId />
    <AotAnywhereLinuxSysrootId Condition="'$(RuntimeIdentifier)' == 'linux-x64'">ubuntu-18.04-amd64</AotAnywhereLinuxSysrootId>
    <AotAnywhereLinuxSysrootId Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">ubuntu-18.04-arm64</AotAnywhereLinuxSysrootId>
    <AotAnywhereLinuxSysrootId Condition="'$(RuntimeIdentifier)' == 'linux-arm'">ubuntu-18.04-arm</AotAnywhereLinuxSysrootId>
    <AotAnywhereLinuxSysrootId Condition="'$(RuntimeIdentifier)' == 'linux-musl-x64'">alpine-3.17-amd64</AotAnywhereLinuxSysrootId>
    <AotAnywhereLinuxSysrootId Condition="'$(RuntimeIdentifier)' == 'linux-musl-arm64'">alpine-3.17-arm64</AotAnywhereLinuxSysrootId>
    <AotAnywhereLinuxSysrootId Condition="'$(RuntimeIdentifier)' == 'linux-musl-arm'">alpine-3.17-arm</AotAnywhereLinuxSysrootId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StuDev.AotAnywhere"
      Version="$(AotAnywherePackageVersion)"
      PrivateAssets="all"
      IsImplicitlyDefined="true" />

    <!-- Clang/LLVM for the build host. Only referenced when this build would actually
         cross-link — the same condition as the Crosscompile.targets import in
         StuDev.AotAnywhere.targets (keep in sync) — so RID-less restores and
         plain builds don't download a ~50 MB toolchain they won't use. -->
    <PackageReference Include="StuDev.AotAnywhere.Clang.Toolsets.$(HostRuntimeIdentifier)"
      Version="$(AotAnywhereClangToolsetVersion)"
      PrivateAssets="all"
      IsImplicitlyDefined="true"
      GeneratePathProperty="true"
      Condition="'$(UseExternalClang)' != 'true' and '$(HostRuntimeIdentifier)' != '' and ($(RuntimeIdentifier.Contains('linux')) or $(RuntimeIdentifier.Contains('osx')) or ($(RuntimeIdentifier.StartsWith('win')) and !$([MSBuild]::IsOSPlatform('Windows'))))" />

    <PackageReference Include="StuDev.AotAnywhere.Linux.Sysroots.$(AotAnywhereLinuxSysrootId)"
      Version="$(AotAnywhereLinuxSysrootVersion)"
      PrivateAssets="all"
      IsImplicitlyDefined="true"
      GeneratePathProperty="true"
      Condition="'$(UseExternalClang)' != 'true' and '$(AotAnywhereLinuxSysrootId)' != '' and ('$(AotAnywhereArmv7SysrootsAvailable)' == 'true' or !$(AotAnywhereLinuxSysrootId.EndsWith('-arm')))" />

    <PackageReference Include="StuDev.AotAnywhere.Windows.CrossLink"
      Version="$(AotAnywhereWindowsCrossLinkVersion)"
      PrivateAssets="all"
      IsImplicitlyDefined="true"
      GeneratePathProperty="true"
      Condition="'$(UseExternalClang)' != 'true' and '$(AotAnywhereWindowsCrossLinkAvailable)' == 'true' and $(RuntimeIdentifier.StartsWith('win')) and !$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

</Project>
